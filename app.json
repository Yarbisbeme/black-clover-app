{
  "expo": {
    "name": "black-clover-app",
    "slug": "black-clover-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "../assets/images/trebol.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/trebol.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.yarbis.blackcloverapp"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/trebol.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/trebol.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "38426142-dcb7-4a01-bd70-a001489521ed"
      }
    }
  }
}
